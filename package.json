{
  "name": "cemurm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Community-Centered Musical Repertories Manager",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gherkin": "vitest run src/test/gherkin",
    "typecheck": "tsc --noEmit",
    "check:visual": "bash scripts/check-visual-contract.sh",
    "test:e2e": "playwright test --ui",
    "test:e2e:ci": "playwright test --workers=1",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-table": "^9.3.1",
    "cmdk": "^1.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.57.0",
    "motion": "^14.1.0",
    "ogl": "^1.0.11",
    "react": "^19.3.1",
    "react-aria-components": "^1.7.0",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^4.3.1",
    "dotenv": "^18.0.5",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "playwright": "^1.55.1",
    "supabase": "^2.120.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "^6.4.3",
    "vitest": "^5.0.2"
  }
}
